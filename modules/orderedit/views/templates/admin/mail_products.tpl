<tr style="border:1px solid #D6D4D4;background-color: {$bg_color_row|escape:'htmlAll'};">
    <td style="border:1px solid #D6D4D4;padding: 0.6em 0.4em;width: 15%;">{$product_reference}</td>
    <td style="border:1px solid #D6D4D4;padding: 0.6em 0.4em;width: 30%;"><strong>{$product_name}</strong></td>
    <td style="border:1px solid #D6D4D4;padding: 0.6em 0.4em; width: 20%;">{$unit_price}</td>
    <td style="border:1px solid #D6D4D4;padding: 0.6em 0.4em; width: 15%;">{$customization_quantity}</td>
    <td style="border:1px solid #D6D4D4;padding: 0.6em 0.4em; width: 20%;">{$total_row_price}</td>
</tr>
