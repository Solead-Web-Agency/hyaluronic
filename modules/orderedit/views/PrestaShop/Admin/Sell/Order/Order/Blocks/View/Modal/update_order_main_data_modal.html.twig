                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
                        {{ 'Cancel'|trans({}, 'Admin.Actions') }}
                    </button>
                    <a href="" class="btn btn-primary" id="update_order_main_data">
                        {{ 'Update'|trans({}, 'Admin.Actions') }}
                    </a>
                </div>
            </div>
        </div>
    </form>
