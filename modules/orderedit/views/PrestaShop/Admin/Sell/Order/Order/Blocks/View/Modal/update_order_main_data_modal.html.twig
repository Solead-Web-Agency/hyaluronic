<div class="modal fade" id="editOrderMainDataModal" tabindex="-1" role="dialog">
    <form>
        <div class="modal-dialog" role="document">
            <div class="modal-content update_order_main_data_modal">
                <div class="modal-header">
                    <h5 class="modal-title">{{ 'Order detail'|trans({}, 'Modules.Orderedit.Admin') }}</h5>
                    <button type="button" class="close" data-dismiss="modal"
                            aria-label="{{ 'Close'|trans({}, 'Admin.Actions') }}">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-control-label" for="order_date_add">
                            {{ 'Created date'|trans({}, 'Modules.Orderedit.Admin') }}
                        </label>
                        <input type="text" id="order_date_add" name="order_date_add" class="form-control" value="{{ orderRaw.date_add }}">
                    </div>
                    <div class="form-group">
                        <label class="form-control-label" for="order_date_upd">
                            {{ 'Updated date'|trans({}, 'Modules.Orderedit.Admin') }}
                        </label>
                        <input type="text" id="order_date_upd" name="order_date_upd" class="form-control" value="{{ orderRaw.date_add }}">
                    </div>
                    <div class="form-group">
                        <label class="form-control-label" for="order_reference">
                            {{ 'Reference'|trans({}, 'Modules.Orderedit.Admin') }}
                        </label>
                        <input type="text" id="order_reference" name="order_reference" class="form-control" value="{{ orderRaw.reference }}">
                    </div>
                    <div class="form-group">
                        <label class="form-control-label">
                            {{ 'Customer ID'|trans({}, 'Modules.Orderedit.Admin') }}
                        </label>
                        <input type="text" id="order_customer_id" name="order_customer_id" class="form-control col-3" value="{{ orderRaw.id_customer }}">
                        <small class="form-text">
                            {{ 'Type the customer id, just a number'|trans({}, 'Modules.Orderedit.Admin') }}
                        </small>
                    </div>
