{% for payment in orderForViewing.payments.payments %}
    <div class="modal fade" id="updateOrderPayment_{{ payment.paymentId }}" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ 'Payment'|trans({}, 'Modules.Orderedit.Admin') }}</h5>
                    <button type="button" class="close" data-dismiss="modal"
                            aria-label="{{ 'Close'|trans({}, 'Admin.Actions') }}">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-control-label" for="payment_date">
                            {{ 'Payment date'|trans({}, 'Modules.Orderedit.Admin') }}
                        </label>
                        <input type="text" id="payment_date" name="payment_date" class="form-control"
                               value="{{ payment.date|date_format_full }}"
                        >
                    </div>
                    <div class="form-group">
                        <label class="form-control-label" for="transaction">
                            {{ 'Transaction Id'|trans({}, 'Modules.Orderedit.Admin') }}
                        </label>
                        <input type="text" id="transaction" name="transaction" class="form-control"
                               value="{{ payment.transactionId }}"
                        >
                    </div>
                    <div class="d-none">
                        <input type="hidden" name="id_payment" value="{{ payment.paymentId }}"/>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
                        {{ 'Cancel'|trans({}, 'Admin.Actions') }}
                    </button>
                    <a href="" class="btn btn-primary" id="update_order_payment">
                        {{ 'Update'|trans({}, 'Admin.Actions') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endfor %}
